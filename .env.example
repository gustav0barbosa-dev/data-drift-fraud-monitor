# ============================================================
# Data Drift Fraud Monitor - Variáveis de Ambiente
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=drift_monitor
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
DATABASE_URL=postgresql://admin:admin123@db:5432/drift_monitor
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Aplicar migrations e seed ao subir o container
RUN_MIGRATIONS=true
SEED_DATABASE=true
BACKEND_RELOAD=true
ALLOW_MOCK_PREDICTIONS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- PgAdmin (opcional) ----
PGADMIN_EMAIL=admin@drift.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ---- ML ----
MODEL_PATH=/app/models

# ---- Dataset ----
DATASET_PATH=/app/data/paysim.csv