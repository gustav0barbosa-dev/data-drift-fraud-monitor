# ============================================================
# Data Drift Fraud Monitor - Variáveis de Ambiente
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=drift_monitor
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8000
DEBUG=true
DATABASE_URL=postgresql://admin:admin123@db:5432/drift_monitor

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- PgAdmin (opcional) ----
PGADMIN_EMAIL=admin@drift.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ---- ML ----
MODEL_PATH=/app/models
DEFAULT_MODEL=xgboost

# ---- Drift Thresholds ----
PSI_THRESHOLD=0.25
KS_PVALUE_THRESHOLD=0.05
JS_THRESHOLD=0.1
WASSERSTEIN_THRESHOLD=0.1

# ---- Dataset ----
DATASET_PATH=/app/data/paysim.csv